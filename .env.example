# Injected through the MCP client's env block; the server does not read this file automatically.
OPENAI_API_KEY=replace-with-your-key
# Leave empty for the official endpoint; a bare domain gets /v1 appended, an existing path is kept. Do not enter /images/generations.
OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_GEN_MODEL=gpt-image-2.5-sunburst
# Leave empty to use gpt-image-mcp/images under the home directory; images are saved in yyyy/MM/dd subdirectories.
IMAGE_GEN_OUTPUT_DIR=
IMAGE_GEN_TIMEOUT_MS=300000
# How the API returns images: b64_json (default, Base64 data) or url (a download link).
# Some relay services return url by default; set this to url so such images are received correctly.
IMAGE_GEN_RESPONSE_FORMAT=b64_json
