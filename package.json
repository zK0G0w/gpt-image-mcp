{
  "name": "gpt-image-mcp",
  "version": "0.3.1",
  "description": "Local stdio MCP server for GPT Image: text-to-image, image editing and reference-style generation",
  "license": "MIT",
  "author": "WainZeng",
  "repository": {
    "type": "git",
    "url": "https://github.com/zK0G0w/gpt-image-mcp.git"
  },
  "keywords": [
    "mcp",
    "openai",
    "gpt-image",
    "image-generation",
    "image-editing",
    "ai",
    "claude",
    "model-context-protocol"
  ],
  "type": "module",
  "bin": {
    "gpt-image-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "openai": "^7.13.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
